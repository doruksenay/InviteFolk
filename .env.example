# Uygulama (Expo) — bu değerler istemciye gömülür, gizli değildir.
# Bu dosyayı .env.local olarak kopyalayıp doldurun.
EXPO_PUBLIC_SUPABASE_URL=https://PROJE_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Davetlilerin açtığı cevap sayfasının adresi (ör. https://davet.app → https://davet.app/r/<token>)
EXPO_PUBLIC_WEB_URL=https://davet.app

# ---------------------------------------------------------------------------
# Edge function sırları — BURAYA DEĞİL, Supabase'e yazılır:
#   npx supabase secrets set --env-file supabase/.env
# supabase/.env içeriği:
#
# WHATSAPP_TOKEN=EAAG...                 (Meta sistem kullanıcısı kalıcı token'ı)
# WHATSAPP_PHONE_NUMBER_ID=1234567890    (WhatsApp Manager → telefon numarası kimliği)
# WHATSAPP_APP_SECRET=abc123             (Meta uygulaması → Ayarlar → Temel → Uygulama sırrı)
# WHATSAPP_VERIFY_TOKEN=uzun-rastgele-bir-dize
# WHATSAPP_INVITE_TEMPLATE=davet_lcv
# WHATSAPP_TEMPLATE_LANG=tr
# WHATSAPP_TEMPLATE_LANG_EN=en
# ALLOWED_ORIGINS=https://davet.app            (web panelinin adresi; virgülle birden fazla)
# WHATSAPP_GRAPH_VERSION=v23.0
#
# SUPABASE_URL, SUPABASE_ANON_KEY ve SUPABASE_SERVICE_ROLE_KEY fonksiyonlara
# Supabase tarafından otomatik verilir; service role anahtarını asla uygulamaya koymayın.
