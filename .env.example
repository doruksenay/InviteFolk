# ===========================================================================
# 1) Uygulama (Expo) — bu değerler uygulamaya/web'e gömülür, GİZLİ DEĞİLDİR.
#    Bu dosyayı .env.local olarak kopyalayıp doldurun; EAS derlemeleri için
#    `npx eas-cli@latest env:create` ile de tanımlayın.
# ===========================================================================
EXPO_PUBLIC_SUPABASE_URL=https://PROJE_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Davetli sayfasının adresi (https://davet.app → https://davet.app/r/<token>)
EXPO_PUBLIC_WEB_URL=https://davet.app
# RevenueCat herkese açık SDK anahtarları (uygulama içi satın alma)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# ===========================================================================
# 2) Sunucu sırları — BURAYA DEĞİL, Supabase'e yazılır:
#      npx supabase secrets set --env-file supabase/.env
#    (supabase/.env git'e girmez). Ayrıntı: docs/automation.md, docs/payments.md
# ===========================================================================
# --- Genel
# APP_WEB_URL=https://davet.app                 (e-posta linkleri, ödeme dönüşü; yalnızca https)
# ALLOWED_ORIGINS=https://davet.app             (web paneli kökenleri; virgülle birden fazla)
#
# --- WhatsApp Cloud API (Meta)
# WHATSAPP_TOKEN=EAAG...                        (sistem kullanıcısı kalıcı token'ı)
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_APP_SECRET=...                       (webhook imzası için)
# WHATSAPP_VERIFY_TOKEN=uzun-rastgele-bir-dize
# WHATSAPP_INVITE_TEMPLATE=davet_lcv
# WHATSAPP_TABLE_TEMPLATE=davet_masa
# WHATSAPP_TEMPLATE_LANG=tr
# WHATSAPP_TEMPLATE_LANG_EN=en
# WHATSAPP_GRAPH_VERSION=v23.0
#
# --- E-posta (Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Davet <davet@alanadiniz.com>
# EMAIL_REPLY_TO=destek@alanadiniz.com          (isteğe bağlı)
#
# --- Zamanlanmış işler ve bildirim
# CRON_SECRET=en-az-16-karakter-rastgele
# EXPO_ACCESS_TOKEN=...                         (isteğe bağlı; Expo push güvenliği açıksa)
#
# --- Ödeme
# IYZICO_API_KEY=...
# IYZICO_SECRET_KEY=...
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com   (canlıda https://api.iyzipay.com)
# REVENUECAT_WEBHOOK_SECRET=en-az-16-karakter-rastgele
# REVENUECAT_ALLOW_SANDBOX=true                 (canlıda false)
#
# SUPABASE_URL, SUPABASE_ANON_KEY ve SUPABASE_SERVICE_ROLE_KEY fonksiyonlara Supabase
# tarafından otomatik verilir. Servis anahtarını ASLA uygulamaya, web'e ya da depoya koymayın.
