{
  "expo": {
    "name": "Invitefolk",
    "slug": "invitefolk",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "invitefolk",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.invitefolk.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.invitefolk.app",
      "adaptiveIcon": {
        "backgroundColor": "#6C5CE7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Invitefolk",
      "themeColor": "#FFF9F4",
      "backgroundColor": "#FFF9F4"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "Davetli listesine telefon rehberinden kişi eklemek için rehberine erişmek istiyoruz. / We use your contacts only to add guests you choose."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kendi davetiye tasarımını yüklemek için fotoğraflarına erişmek istiyoruz. / We use your photos only to upload your invitation design.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C5CE7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "description": "Invitations, WhatsApp invites, live RSVPs and seating plans for any event: weddings, birthdays, dinners, five-a-side. / Düğünden halı saha maçına her etkinlik için davetiye, WhatsApp ile davet, canlı LCV ve oturma planı."
  }
}
